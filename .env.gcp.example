# ====================================================
# Crypto Risk Manager - Google Cloud Production Config
# ====================================================

# Google Cloud Deployment Defaults
GCP_PROJECT_ID=agentic-risk-hack
GCP_REGION=us-central1
BACKEND_SERVICE_NAME=agentic-risk-backend
FRONTEND_SERVICE_NAME=agentic-risk-frontend

# Privy Credentials (for wallet & session authentication)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# Database Configuration
# Production Cloud SQL: postgresql+asyncpg://<USER>:<PASSWORD>@/<DB_NAME>?host=/cloudsql/<PROJECT>:<REGION>:<INSTANCE>
# Or fallback to SQLite file: sqlite+aiosqlite:///risk_manager.db
DATABASE_URL=sqlite+aiosqlite:///risk_manager.db

# Optional External API Keys (Leave blank to use mock/public feeds)
THE_GRAPH_API_KEY=
COINGECKO_API_KEY=
ONEINCH_API_KEY=
GEMINI_API_KEY=

# Optional Redis Cache (Leave blank for in-memory cache fallback)
REDIS_URL=
